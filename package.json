{
  "name": "browser-extension",
  "version": "5.1.0",
  "private": true,
  "dependencies": {
    "global-input-react": "^4.6.9",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "styled-components": "^6.1.11"
  },
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build && vite build --config vite.content.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "rm -rf build && npm run build && cd build && zip -r ./globalinputapp.zip .",
    "build:firefox": "npm run build && node scripts/firefox-manifest.mjs",
    "package:firefox": "npm run build:firefox && rm -f globalinputapp-firefox.zip && cd build-firefox && zip -qr ../globalinputapp-firefox.zip .",
    "package:source": "git archive --format=zip --output=globalinputapp-source.zip HEAD"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  },
  "type": "module"
}
